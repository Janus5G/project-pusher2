# Project Pusher - environment template
# Copy this file to .env and fill in your own values.
# Do NOT commit this file with an actual token.
#
# .env is git-ignored. Tokens belong in your local shell, in an OS keychain,
# or in GitHub Actions secrets - never in source control.

# GitHub Personal Access Token used when pushing to repositories.
# Classic token:      needs the "repo" scope.
# Fine-grained token: needs "Contents: Read and write" on the target repo.
# GITHUB_TOKEN=ghp_replace_with_your_own_token

# Default branch Project Pusher pushes to.
# DEFAULT_BRANCH=main

# Default git remote name.
# DEFAULT_REMOTE=origin

# Optional: author identity used for automated pushes.
# GIT_AUTHOR_NAME=Project Pusher
# GIT_AUTHOR_EMAIL=pusher@users.noreply.github.com
